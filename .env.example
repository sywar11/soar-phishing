# Copier ce fichier en .env puis renseigner les clés (toutes optionnelles).
# Sans clé, la source de réputation correspondante est simplement ignorée.

# Boîte de signalement
REPORT_MAILBOX=phishing@corp.local
SOC_SENDER=soc@corp.local
INTERNAL_DOMAINS=corp.local

# Seuils du score (0-100)
THRESHOLD_SUSPICIOUS=20
THRESHOLD_MALICIOUS=70

# Interroger les services de réputation en ligne (true/false)
ENABLE_ONLINE_LOOKUPS=true
# Suivre les redirections HTTP des URL (requête HEAD vers l'URL suspecte !) - à n'activer que dans un réseau isolé
FOLLOW_REDIRECTS=false

# Clés API (gratuites)
VT_API_KEY=
OTX_API_KEY=
URLHAUS_AUTH_KEY=
# Nombre max de requêtes VirusTotal par analyse (clé gratuite = 4/min)
VT_MAX_LOOKUPS=4

# TheHive (profil "thehive") : créer une organisation + un utilisateur "analyst" puis une clé API
THEHIVE_URL=
THEHIVE_API_KEY=

# URL publique du tableau de bord (utilisée dans les e-mails et liens)
PUBLIC_ANALYZER_URL=http://localhost:8000
